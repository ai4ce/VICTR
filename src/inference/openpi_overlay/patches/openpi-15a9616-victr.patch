+@dataclasses.dataclass(frozen=True)
+class YorVictrDataConfig(YorDataConfig):
+    """Serving-only VICTR inputs: live retrieval after the local YOR camera adapter.
+
+    The demo pool contains held-out episodes; context encoding and fixed fusion
+    follow LucaMacesanu/openpi@086a9869. No precomputed training-row lookup.
+    """
+
+    # Search path (os.pathsep-separated): demo-dataset pools, then in-domain icl-dataset pools built
+    # from training's own pool split (build_indomain_pool.py). A task may exist in only one.
+    pool_dir: str = "/home/lairlab/icl_ws/assets/victr_icl_pool_demo:/home/lairlab/icl_ws/assets/victr_icl_pool_indomain"
+    num_context_chunks: int = 1
+    context_frames_per_chunk: int = 1
+    context_text_max_length: int = 64
+    fusion_lambda: float = 1.0
+    retrieval_metric: str | None = None
+    # ("zed",) is the retrieval the checkpoints were trained with; adding "fish0"/"fish1"
+    # needs a pool built with build_victr_pool.py --add-wrist-cameras.
+    retrieval_key_cameras: tuple[str, ...] = ("zed",)
+    # "retrieved", "random" (a random same-task chunk, EXP B3) or "none" (no context, EXP B1).
+    context_mode: str = "retrieved"
+    # Keep only each task pool's N shortest keep=true demonstrations (experiments.py EXP E); None: all.
+    pool_demos: int | None = None
+    prompt_to_task_overrides: dict[str, str] = dataclasses.field(default_factory=dict)
+    # "auto": each pool's declared key preprocessing -- raw for the in-domain pools (as training),
+    # letterbox for the demo pools, which do not declare it.
+    query_image_mode: str = "auto"
+    missing_pool: str = "error"
+    robometer_python: str | None = None
+    robometer_device: str = "cuda"
+    # "robometer", "robometer_ft", "vfe" or "vfe_recap" (yor_retrieval.RetrievalContextInputs.value_estimator).
+    value_estimator: str = "robometer"
+    vfe_python: str | None = None
+    vfe_device: str = "cuda"
+
+    def context_encoding_kwargs(self) -> dict:
+        return {}
+
+    def output_transform(self) -> _transforms.DataTransformFn:
+        return yor_policy.YorOutputs()
+
+    @override
+    def create(self, assets_dirs: pathlib.Path, model_config: _model.BaseModelConfig) -> DataConfig:
+        data_transforms = _transforms.Group(
+            inputs=[
+                yor_policy.YorInputs(state_dim=self.state_dim, retrieval_metadata=True),
+                yor_retrieval.RetrievalContextInputs(
+                    pool_dir=self.pool_dir,
+                    num_context_chunks=self.num_context_chunks,
+                    context_frames_per_chunk=self.context_frames_per_chunk,
+                    context_text_max_length=self.context_text_max_length,
+                    retrieval_metric=self.retrieval_metric or getattr(model_config, "retrieval_metric", "vision"),
+                    retrieval_key_cameras=self.retrieval_key_cameras,
+                    context_mode=self.context_mode,
+                    pool_demos=self.pool_demos,
+                    fusion_lambda=self.fusion_lambda,
+                    prompt_to_task_overrides=self.prompt_to_task_overrides,
+                    query_image_mode=self.query_image_mode,
+                    missing_pool=self.missing_pool,
+                    robometer_python=self.robometer_python,
+                    robometer_device=self.robometer_device,
+                    value_estimator=self.value_estimator,
+                    vfe_python=self.vfe_python,
+                    vfe_device=self.vfe_device,
+                    **self.context_encoding_kwargs(),
+                ),
+            ],
+            outputs=[self.output_transform()],
+        )
+        model_transforms = ModelTransformFactory(default_prompt=self.default_prompt)(model_config)
+
+        return dataclasses.replace(
+            self.create_base_config(assets_dirs, model_config),
+            data_transforms=data_transforms,
+            model_transforms=model_transforms,
+        )
+
