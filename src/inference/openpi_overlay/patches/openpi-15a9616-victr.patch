+@dataclasses.dataclass(frozen=True)
+class YorDataConfig(DataConfigFactory):
+    """Data config for the YOR bimanual pi0.5 checkpoint (inference only -- no LeRobot dataset attached).
+
+    Two checkpoint families exist (see yor_policy.YorInputs docstring for full confirmation sources):
+      state_dim=14 (default): [left_joints(7), right_joints(7)], actions=16
+        ([left_ee(7), right_ee(7), gripper(2)]); confirmed empirically against the actual checkpoint's
+        Orbax param shapes (Pi0Config(pi05=True, action_dim=32) loads with no shape errors -- the real
+        16-dim action is zero-padded to 32 by the shared model transform) and against
+        joystick_policy_teleop.py's curr_pose field layout on the Pi.
+      state_dim=15 (the lair-nyu yor_icl_* checkpoints, 2026-08-14): + lift(1); actions=20
+        (+ base_vel(3) + lift_cmd(1)); confirmed against the sibling lerobot checkpoint's config.json
+        and stats.json (same dimension-for-dimension mean/std ranges as these checkpoints' own
+        norm_stats.json) and against collect.py's original data-collection column order.
+    These checkpoints also use a different `assets` asset_id ("icl-dataset" vs. the older
+    checkpoints' "train") -- set via AssetsConfig(asset_id=...) on each TrainConfig entry below, not
+    by this class.
+    """
+
+    default_prompt: str | None = None
+    state_dim: int = 14
+
+    @override
+    def create(self, assets_dirs: pathlib.Path, model_config: _model.BaseModelConfig) -> DataConfig:
+        data_transforms = _transforms.Group(
+            inputs=[yor_policy.YorInputs(state_dim=self.state_dim)],
+            outputs=[yor_policy.YorOutputs()],
+        )
+        model_transforms = ModelTransformFactory(default_prompt=self.default_prompt)(model_config)
+
+        return dataclasses.replace(
+            self.create_base_config(assets_dirs, model_config),
+            data_transforms=data_transforms,
+            model_transforms=model_transforms,
+        )
+
